#' Display Available Climate Datasets
#'
#' The `clim4health_get_datasets` function displays a list of available climate
#' datasets that can be usedfor health and climate research, specifically
#' using ERA5 reanalysis datasets.
#'
#' @return Prints a list of available climate datasets to the console.
#'
#' @examples
#' # Display the climate datasets
#' clim4health_get_datasets()
#'
#' @export
#' 

source("dataset_info.R")

clim4health_get_datasets <- function() {
  datasets <- names(datasets_info)

  cat("Available climate datasets:\n")
  for (dataset in datasets) {
    cat("-", dataset, "\n")
  }
}

